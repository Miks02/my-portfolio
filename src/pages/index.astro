---
import About from "../components/sections/About.astro";
import Hero from "../components/sections/Hero.astro";
import Projects from "../components/sections/Projects.astro";
import TechStack from "../components/sections/TechStack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isPlaceholder, site } from "../data/site";
import { getProjects } from "../data/collections";
import { getLang, localizePath, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Only real profile URLs go into sameAs; placeholders are skipped until filled in.
const sameAs = Object.values(site.socials).filter((url) => !isPlaceholder(url));

const projects = (await getProjects(lang)).map(({ slug, data }) => ({
  title: data.title,
  kind: data.kind,
  summary: data.summary,
  stack: data.stack,
  liveUrl: data.liveUrl,
  repoUrl: data.repoUrl,
  caseStudyHref: data.caseStudy
    ? localizePath(lang, `/projects/${slug}/`)
    : undefined,
  cover: data.cover,
  coverAlt: data.coverAlt,
  labels: {
    live: t("projects.live"),
    repo: t("projects.repo"),
    caseStudy: t("projects.caseStudy"),
    screenshot: t("projects.screenshot").replace("{title}", data.title),
  },
}));

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: t("meta.jobTitle"),
  url: Astro.site?.href,
  sameAs,
};
---

<BaseLayout jsonLd={person} trackSections>
  <Hero
    name={site.name}
    location={t("common.location")}
    title={t("hero.title")}
    text={t("hero.text")}
    ctaLabel={t("hero.cta")}
    ctaHref="#contact"
    resumeLabel={t("hero.resume")}
    resumeHref={site.resumeUrl}
    portraitAlt={t("hero.portraitAlt")}
  />
  <TechStack label={t("stack.label")} items={site.techStack} />
  <About
    index={1}
    label={t("about.label")}
    heading={t("about.heading")}
    lead={t("about.lead")}
    body={t("about.body")}
    facts={[
      {
        label: t("about.fact.basedIn.label"),
        value: t("about.fact.basedIn.value"),
      },
      {
        label: t("about.fact.availability.label"),
        value: t("about.fact.availability.value"),
      },
      {
        label: t("about.fact.english.label"),
        value: t("about.fact.english.value"),
      },
      {
        label: t("about.fact.currently.label"),
        value: t("about.fact.currently.value"),
      },
    ]}
  />
  <Projects
    index={2}
    label={t("projects.label")}
    heading={t("projects.heading")}
    note={t("projects.note")}
    projects={projects}
  />
</BaseLayout>
