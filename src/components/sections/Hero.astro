---
import Button from "../ui/Button.astro";
import PortraitRing from "../ui/PortraitRing.astro";

interface Props {
  name: string;
  location: string;
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
  resumeLabel: string;
  resumeHref: string;
  portraitAlt: string;
}

const {
  name,
  location,
  title,
  text,
  ctaLabel,
  ctaHref,
  resumeLabel,
  resumeHref,
  portraitAlt,
} = Astro.props;

// "Milan Nikolić" renders as "Milan / Nikolić" on two lines.
const nameLines = name.split(" ");
---

<section id="top" class="relative overflow-hidden pt-18">
  <div class="mx-auto flex max-w-300 flex-col gap-8 px-6 md:px-12 lg:flex-row lg:items-stretch">
    <div class="flex min-w-0 flex-1 flex-col justify-center pt-10 pb-12 md:pt-14 lg:pb-24">
      <p class="rise flex items-center gap-3 font-mono text-[12px] tracking-[0.08em] text-muted uppercase md:text-[13px]">
        <span aria-hidden="true" class="inline-block size-2 bg-accent"></span>
        {location}
      </p>

      <h1
        class="rise mt-7 text-[58px] leading-[0.95] font-semibold tracking-[-0.035em] md:text-[clamp(56px,7vw,96px)]"
        style="animation-delay: 80ms"
      >
        {nameLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>

      <p
        class="rise mt-7 flex items-center gap-4.5"
        style="animation-delay: 160ms"
      >
        <span
          aria-hidden="true"
          class="inline-block h-0.5 w-10 bg-accent md:w-14"
        ></span>
        <span class="text-[22px] font-medium tracking-[-0.015em] md:text-[28px]">
          {title}
        </span>
      </p>

      <p
        class="rise mt-6 max-w-110 text-[17px] leading-[1.6] text-muted md:text-[18px]"
        style="animation-delay: 240ms"
      >
        {text}
      </p>

      <div class="rise mt-10 flex gap-3.5" style="animation-delay: 320ms">
        <Button href={ctaHref} class="flex-1 md:flex-none">
          {ctaLabel}
        </Button>
        <Button
          href={resumeHref}
          variant="secondary"
          newTab
          class="flex-1 md:flex-none"
        >
          {resumeLabel}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M7 1v9M3 6.5 7 10.5 11 6.5M1.5 13h11"></path>
          </svg>
        </Button>
      </div>
    </div>

    <PortraitRing
      alt={portraitAlt}
      media="(min-width: 64rem)"
      priority
      class="hidden lg:block"
    />
  </div>
</section>
