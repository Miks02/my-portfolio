---
import type { ImageMetadata } from "astro";
import OtherProjectCard from "../ui/OtherProjectCard.astro";
import SectionLabel from "../ui/SectionLabel.astro";

interface OtherProject {
  title: string;
  since?: string;
  summary: string;
  stack: string[];
  repoUrl?: string;
  cover?: ImageMetadata;
  coverAlt: string;
}

interface Props {
  index: number;
  label: string;
  heading: string;
  note: string;
  repoLabel: string;
  sinceLabel: string;
  projects: OtherProject[];
}

const { index, label, heading, note, repoLabel, sinceLabel, projects } =
  Astro.props;
---

<section
  id="other-projects"
  data-nav-section="projects"
  aria-labelledby="other-projects-heading"
  class="mx-auto max-w-300 px-6 pb-16 md:px-12 md:pb-30"
>
  <div
    data-reveal
    class="flex flex-wrap items-end justify-between gap-6 border-b border-line pb-8"
  >
    <div>
      <SectionLabel index={index} label={label} />
      <h2
        id="other-projects-heading"
        class="mt-5 text-[34px] leading-[1.05] font-semibold tracking-[-0.03em] md:text-[48px]"
      >
        {heading}
      </h2>
    </div>
    <p class="max-w-85 text-[16px] leading-[1.6] text-muted">{note}</p>
  </div>

  <div class="mt-10 grid gap-6 md:mt-14 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <OtherProjectCard
        title={project.title}
        since={project.since}
        summary={project.summary}
        stack={project.stack}
        repoUrl={project.repoUrl}
        cover={project.cover}
        coverAlt={project.coverAlt}
        repoLabel={repoLabel}
        sinceLabel={sinceLabel}
      />
    ))}
  </div>
</section>
