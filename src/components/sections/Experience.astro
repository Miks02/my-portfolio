---
import type { ComponentProps } from "astro/types";
import SectionLabel from "../ui/SectionLabel.astro";
import TimelineItem from "../ui/TimelineItem.astro";

interface Props {
  index: number;
  label: string;
  heading: string;
  items: readonly ComponentProps<typeof TimelineItem>[];
}

const { index, label, heading, items } = Astro.props;
---

<section id="experience" aria-labelledby="experience-heading" class="bg-ink-2">
  <div class="mx-auto flex max-w-300 flex-col gap-12 px-6 py-20 md:px-12 md:py-30 lg:flex-row lg:gap-20">
    <header data-reveal class="min-w-0 lg:flex-1">
      <SectionLabel index={index} label={label} />
      <h2
        id="experience-heading"
        class="mt-5 text-[34px] leading-[1.05] font-semibold tracking-[-0.03em] md:text-[48px]"
      >
        {heading}
      </h2>
    </header>

    <ol class="min-w-0 border-l border-rule pl-8 lg:flex-[1.6]">
      {items.map((item) => (
        <TimelineItem {...item} />
      ))}
    </ol>
  </div>
</section>
