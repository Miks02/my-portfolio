---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import TextLink from "./TextLink.astro";

interface Props {
  title: string;
  /** Project start, e.g. "Nov 2025". Hidden when missing. */
  since?: string;
  summary: string;
  stack: string[];
  repoUrl?: string;
  cover?: ImageMetadata;
  /** Alt text for the cover, e.g. "Flower Shop screenshot". */
  coverAlt: string;
  repoLabel: string;
  sinceLabel: string;
}

const {
  title,
  since,
  summary,
  stack,
  repoUrl,
  cover,
  coverAlt,
  repoLabel,
  sinceLabel,
} = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-md border border-line bg-ink-2">
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 700, 1000]}
      sizes="(min-width: 2560px) 470px, (min-width: 1024px) 352px, (min-width: 768px) 324px, calc(100vw - 48px)"
      quality={90}
      class="aspect-2/1 w-full bg-surface object-cover object-top"
    />
  ) : (
    <div aria-hidden="true" class="aspect-2/1 w-full bg-surface" />
  )}

  <div class="flex flex-1 flex-col border-t border-line px-5 pt-5 pb-2">
    {since && (
      <p class="mb-2 font-mono text-[12px] tracking-[0.06em] text-dim uppercase">
        {sinceLabel} {since}
      </p>
    )}
    <h3 class="text-[19px] leading-[1.3] font-semibold tracking-[-0.01em]">
      {title}
    </h3>
    <p class="mt-2.5 text-[15px] leading-[1.6] text-muted">{summary}</p>
    <p class="mt-4 font-mono text-[12px] leading-[1.8] text-subtle">
      {stack.join(" · ")}
    </p>

    {repoUrl && (
      <div class="mt-auto pt-3">
        <TextLink href={repoUrl} external>
          {repoLabel}
        </TextLink>
      </div>
    )}
  </div>
</article>
