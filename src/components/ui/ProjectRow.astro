---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import TextLink from "./TextLink.astro";

interface Props {
  index: number;
  title: string;
  kind: string;
  summary: string;
  stack: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  /** Case-study URL; omitted when the project has none. */
  caseStudyHref?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  labels: {
    live: string;
    repo: string;
    caseStudy: string;
    /** Text inside the empty screenshot frame, also the fallback alt text for a cover. */
    screenshot: string;
  };
}

const {
  index,
  title,
  kind,
  summary,
  stack,
  liveUrl,
  repoUrl,
  caseStudyHref,
  cover,
  coverAlt,
  labels,
} = Astro.props;

const number = String(index).padStart(2, "0");
const hasLinks = Boolean(liveUrl || repoUrl || caseStudyHref);
---

<article
  data-reveal
  class="flex flex-col-reverse gap-10 border-b border-line py-14 last:border-b-0 last:pb-0 md:py-16 lg:flex-row lg:gap-18"
>
  <div class="flex min-w-0 flex-col lg:flex-1">
    <p class="font-mono text-[12px] text-dim md:text-[13px]">
      {number} / {kind}
    </p>
    <h3 class="mt-4 text-[30px] leading-[1.1] font-semibold tracking-tight md:text-[40px]">
      {title}
    </h3>
    <p class="mt-4.5 text-[17px] leading-[1.7] text-muted">{summary}</p>
    <p class="mt-6 font-mono text-[13px] leading-[1.8] text-subtle">
      {stack.join(" · ")}
    </p>

    {hasLinks && (
      <div class="mt-6 flex flex-wrap gap-x-7 gap-y-1 md:mt-7">
        {liveUrl && (
          <TextLink href={liveUrl} external underline="accent">
            {labels.live}
          </TextLink>
        )}
        {repoUrl && (
          <TextLink href={repoUrl} external>
            {labels.repo}
          </TextLink>
        )}
        {caseStudyHref && (
          <TextLink href={caseStudyHref} arrow>
            {labels.caseStudy}
          </TextLink>
        )}
      </div>
    )}
  </div>

  <div class="min-w-0 lg:flex-[1.3]">
    {cover ? (
      <a href={liveUrl} target="_blank">
        <Image
          src={cover}
          alt={coverAlt ?? labels.screenshot}
          widths={[640, 960, 1280, 1600, cover.width]}
          sizes="(min-width: 2560px) 780px, (min-width: 1024px) 590px, calc(100vw - 48px)"
          quality={90}
          class="block h-auto w-full rounded-md bg-surface hover:opacity-70 active:scale-95 transition duration-200"
        />
      </a>
    ) : (
      <div
        aria-hidden="true"
        class="flex items-center justify-center rounded-xs bg-surface font-mono text-[12px] text-dim md:text-[13px]"
      >
        [{labels.screenshot}]
      </div>
    )}
  </div>
</article>
