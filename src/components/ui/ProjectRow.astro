---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import TextLink from "./TextLink.astro";

interface Props {
  index: number;
  title: string;
  kind: string;
  summary: string;
  stack: readonly string[];
  /** Project start, e.g. "Dec 2025". Hidden when missing. */
  since?: string;
  liveUrl?: string;
  repoUrl?: string;
  /** Case-study URL; omitted when the project has none. */
  caseStudyHref?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  labels: {
    since: string;
    stack: string;
    live: string;
    repo: string;
    caseStudy: string;
    /** Text inside the empty screenshot frame, also the fallback alt text for a cover. */
    screenshot: string;
  };
}

const {
  index,
  title,
  kind,
  summary,
  stack,
  since,
  liveUrl,
  repoUrl,
  caseStudyHref,
  cover,
  coverAlt,
  labels,
} = Astro.props;

const number = String(index).padStart(2, "0");
const hasLinks = Boolean(liveUrl || repoUrl || caseStudyHref);

const imageProps = cover && {
  src: cover,
  alt: coverAlt ?? labels.screenshot,
  widths: [640, 960, 1280, 1600, cover.width],
  sizes:
    "(min-width: 2560px) 780px, (min-width: 1024px) 590px, calc(100vw - 48px)",
  quality: 90,
};
---

<!-- Text column (kind, title, summary) + a card holding the screenshot, start date, stack and links. -->
<article
  data-reveal
  class="flex flex-col gap-10 border-b border-line py-14 last:border-b-0 last:pb-0 md:py-16 lg:flex-row lg:gap-18"
>
  <div class="flex min-w-0 flex-col lg:flex-1">
    <p class="font-mono text-[12px] text-dim md:text-[13px]">
      {number} / {kind}
    </p>
    <h3 class="mt-4 text-[30px] leading-[1.1] font-semibold tracking-tight md:text-[40px]">
      {title}
    </h3>
    <p class="mt-4.5 text-[17px] leading-[1.7] text-muted">{summary}</p>
  </div>

  <div class="min-w-0 overflow-hidden rounded-md border border-line bg-ink-2 lg:flex-[1.3]">
    {imageProps ? (
      liveUrl ? (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden"
        >
          <Image
            {...imageProps}
            class="block h-auto w-full bg-surface transition duration-200 hover:opacity-70 active:scale-95"
          />
        </a>
      ) : (
        <Image {...imageProps} class="block h-auto w-full bg-surface" />
      )
    ) : (
      <div
        aria-hidden="true"
        class="flex aspect-16/10 items-center justify-center bg-surface font-mono text-[12px] text-dim md:text-[13px]"
      >
        [{labels.screenshot}]
      </div>
    )}

    <div class="border-t border-line px-5 pt-5 pb-2 md:px-6 md:pt-6">
      <dl class="flex flex-col gap-4 sm:flex-row sm:gap-10">
        {since && (
          <div class="shrink-0">
            <dt class="font-mono text-[12px] tracking-[0.06em] text-dim uppercase">
              {labels.since}
            </dt>
            <dd class="mt-1.5 text-[15px] text-fg">{since}</dd>
          </div>
        )}
        <div class="min-w-0">
          <dt class="font-mono text-[12px] tracking-[0.06em] text-dim uppercase">
            {labels.stack}
          </dt>
          <dd class="mt-1.5 font-mono text-[13px] leading-[1.8] text-subtle">
            {stack.join(" · ")}
          </dd>
        </div>
      </dl>

      {hasLinks && (
        <div class="mt-4 flex flex-wrap gap-x-7 border-t border-line pt-1">
          {liveUrl && (
            <TextLink href={liveUrl} external underline="accent">
              {labels.live}
            </TextLink>
          )}
          {repoUrl && (
            <TextLink href={repoUrl} external>
              {labels.repo}
            </TextLink>
          )}
          {caseStudyHref && (
            <TextLink href={caseStudyHref} arrow>
              {labels.caseStudy}
            </TextLink>
          )}
        </div>
      )}
    </div>
  </div>
</article>
