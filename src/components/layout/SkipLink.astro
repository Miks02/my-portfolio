---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<a
  href="#main"
  class="sr-only rounded-xs bg-accent font-semibold text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-60 focus:inline-flex focus:min-h-11 focus:items-center focus:px-5"
>
  {label}
</a>
