---
import { site } from "../../data/site";
import { getLang, useTranslations } from "../../i18n/utils";

interface Props {
  /** Enables active-section tracking (home page only). */
  trackSections?: boolean;
}

const { trackSections = false } = Astro.props;

const t = useTranslations(getLang(Astro.currentLocale));

const links = [
  { id: "about", label: t("nav.about") },
  { id: "projects", label: t("nav.projects") },
  { id: "experience", label: t("nav.experience") },
  { id: "contact", label: t("nav.contact") },
];
---

<!-- 1px sentinel ~16px from the top: once it leaves the viewport the navbar turns solid. -->
<div data-nav-sentinel aria-hidden="true" class="pointer-events-none absolute top-4 left-0 h-px w-px">
</div>

<header
  data-navbar
  data-track-sections={trackSections ? "" : undefined}
  class="group/nav fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-200 data-open:border-line data-open:bg-ink data-scrolled:border-line data-scrolled:bg-ink"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-6 px-6 md:h-[72px] md:px-12">
    <a
      href="/"
      class="-mx-1 inline-flex min-h-11 items-center px-1 text-[18px] font-semibold tracking-[-0.01em] text-fg"
    >
      {site.name}<span class="text-accent">.</span>
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-9 text-[15px]">
        {
          links.map(({ id, label }) => (
            <li>
              <a
                href={`/#${id}`}
                data-nav-link={id}
                class="group/link inline-flex min-h-11 items-center text-muted transition-colors duration-200 hover:text-fg aria-[current=true]:text-fg"
              >
                <span class="border-b-2 border-transparent pt-0.5 pb-0.5 group-aria-current/link:border-accent">
                  {label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      data-nav-toggle
      class="-mr-2.5 inline-flex size-11 items-center justify-center text-fg md:hidden"
      aria-label={t("nav.open")}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={t("nav.open")}
      data-label-close={t("nav.close")}
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <g class="group-data-open/nav:hidden">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </g>
        <g class="hidden group-data-open/nav:block">
          <path d="M5 5l14 14M19 5 5 19"></path>
        </g>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label={t("nav.label")}
    hidden
    class="h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line bg-ink md:hidden"
  >
    <ul class="px-6">
      {
        links.map(({ id, label }) => (
          <li class="border-b border-line">
            <a
              href={`/#${id}`}
              data-nav-link={id}
              data-mobile-link
              class="flex h-14 items-center text-[24px] font-medium text-fg hover:text-accent"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import "../../scripts/navbar.ts";
</script>
