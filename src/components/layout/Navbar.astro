---
import { site } from "../../data/site";
import { getLang, useTranslations } from "../../i18n/utils";

interface Props {
  /** Enables active-section tracking (home page only). */
  trackSections?: boolean;
}

const { trackSections = false } = Astro.props;

const t = useTranslations(getLang(Astro.currentLocale));

const links = [
  { id: "about", label: t("nav.about") },
  { id: "projects", label: t("nav.projects") },
  { id: "experience", label: t("nav.experience") },
  { id: "contact", label: t("nav.contact") },
];
---

<!-- 1px sentinel ~16px from the top: once it leaves the viewport the desktop navbar turns solid. -->
<div
  data-nav-sentinel
  aria-hidden="true"
  class="pointer-events-none absolute top-4 left-0 h-px w-px"
></div>

<!-- Mobile: dims the page behind the open menu; a tap on it closes the menu. -->
<div
  data-nav-scrim
  aria-hidden="true"
  hidden
  class="nav-scrim fixed inset-0 z-40 bg-ink/85 md:hidden"
></div>

<!--
  Mobile (< md): a floating card, 12px from the top and sides, always solid.
  Desktop: a full-width bar, transparent at the top and solid after scrolling.
-->
<header
  data-navbar
  data-track-sections={trackSections ? "" : undefined}
  class="group/nav fixed inset-x-3 top-3 z-50 overflow-hidden rounded-xl border border-line-strong bg-ink md:inset-x-0 md:top-0 md:overflow-visible md:rounded-none md:border-x-0 md:border-t-0 md:border-b md:border-transparent md:bg-transparent md:transition-colors md:duration-200 md:data-scrolled:border-line md:data-scrolled:bg-ink"
>
  <div class="mx-auto flex h-14.5 max-w-300 items-center justify-between gap-6 pr-2.5 pl-3 md:h-18 md:px-12">
    <a
      href="/"
      class="-mx-1 inline-flex min-h-11 items-center px-1 text-[17px] font-semibold tracking-[-0.01em] text-fg md:text-[18px]"
    >
      {site.name}
      <span class="text-accent">.</span>
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-9 text-[15px] font-semibold">
        {links.map(({ id, label }) => (
          <li>
            <a
              href={`/#${id}`}
              data-nav-link={id}
              class="group/link inline-flex min-h-11 items-center text-fg-soft/80 transition-colors duration-200 hover:text-fg aria-[current=true]:text-fg"
            >
              <span class="border-b-2 border-transparent pt-0.5 pb-0.5 group-aria-current/link:border-accent">
                {label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      data-nav-toggle
      class="inline-flex size-11 items-center justify-center rounded-lg border border-line bg-surface text-fg transition-colors duration-200 hover:border-line-strong md:hidden"
      aria-label={t("nav.open")}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={t("nav.open")}
      data-label-close={t("nav.close")}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <g class="group-data-open/nav:hidden">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </g>
        <g class="nav-close-icon hidden group-data-open/nav:block">
          <path d="M5 5l10 10M15 5 5 15"></path>
        </g>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label={t("nav.label")}
    hidden
    class="nav-menu max-h-[calc(100dvh-96px)] overflow-y-auto border-t border-line md:hidden"
  >
    <ul class="px-4 py-1">
      {links.map(({ id, label }, i) => (
        <li
          class="nav-item border-b border-line last:border-b-0"
          style={`--i: ${i}`}
        >
          <a
            href={`/#${id}`}
            data-nav-link={id}
            class="flex h-14 items-center justify-between text-[20px] font-semibold text-fg-soft/80 transition-colors duration-200 hover:text-fg aria-[current=true]:text-fg"
          >
            {label}
            <span aria-hidden="true" class="text-[16px] text-dim">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import "../../scripts/navbar.ts";
</script>

<style>
  /*
    Opening animation (mobile menu). Removing `hidden` restarts these animations:
    the card grows open, the links fade in one after another, the page behind dims,
    and the X icon turns in.
  */
  .nav-menu:not([hidden]) {
    animation: nav-menu-open 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .nav-menu:not([hidden]) .nav-item {
    animation: nav-item-in 280ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(60ms + var(--i) * 45ms);
  }

  .nav-scrim:not([hidden]) {
    animation: nav-fade-in 220ms ease-out both;
  }

  .nav-close-icon {
    transform-box: fill-box;
    transform-origin: center;
    animation: nav-icon-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes nav-menu-open {
    from {
      max-height: 0;
    }
    to {
      /* Taller than the four 56px rows, so the growth looks continuous. */
      max-height: 260px;
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes nav-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes nav-icon-in {
    from {
      opacity: 0;
      transform: rotate(-90deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu:not([hidden]),
    .nav-menu:not([hidden]) .nav-item,
    .nav-scrim:not([hidden]),
    .nav-close-icon {
      animation: none;
    }
  }
</style>
